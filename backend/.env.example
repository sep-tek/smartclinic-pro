# =====================================================
# SmartClinic Pro — Backend Environment Template
# Copy to .env and fill in REAL values. NEVER commit .env.
# =====================================================

# "development" locally, "production" on the deployed server
NODE_ENV=development

PORT=5000

# Public origin of the deployed frontend (required in production)
CLIENT_URL=http://localhost:5173

# Long random secret used to sign JWT tokens (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartclinic
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Note: when the frontend and backend are hosted on DIFFERENT sites,
# the auth cookie must be SameSite=None and Secure=true (HTTPS only).
# The current cookie config uses SameSite=Lax + Secure in production,
# which is correct for same-site hosting.

# --- Database SSL (production) ---
# In production (NODE_ENV=production) the backend connects to PostgreSQL
# over SSL automatically. Neon's connection endpoint is fronted by a load
# balancer whose certificate does not always match the pooler host, so
# certificate verification is relaxed by default for compatibility.
# Set DB_SSL_STRICT=1 on the host to enforce full certificate
# verification when Neon provides a matching CA for your endpoint.
# Local development connections (NODE_ENV != production) are NOT SSL.
# No secret values belong here — see DB_PASSWORD above.
